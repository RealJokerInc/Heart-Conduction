{
  "document": {
    "margin": 2,
    "color": "252"
  },
  "heading": {
    "bold": true,
    "prefix": ""
  },
  "h1": {
    "bold": true,
    "prefix": "▓ ",
    "suffix": " ▓",
    "upper": true,
    "color": "212",
    "background_color": "236"
  },
  "h2": {
    "bold": true,
    "prefix": "║ ",
    "color": "81"
  },
  "h3": {
    "bold": true,
    "prefix": "│ ",
    "color": "215"
  },
  "h4": {
    "bold": true,
    "prefix": "┊ ",
    "color": "186"
  },
  "paragraph": {
    "color": "252"
  },
  "code_block": {
    "theme": "dracula",
    "margin": 2
  },
  "code": {
    "color": "203",
    "background_color": "236"
  },
  "table": {
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─",
    "color": "252"
  },
  "link": {
    "color": "39",
    "underline": true
  },
  "emph": {
    "italic": true,
    "color": "223"
  },
  "strong": {
    "bold": true,
    "color": "230"
  },
  "block_quote": {
    "color": "109",
    "indent": 2,
    "indent_token": "▌ "
  },
  "item": {
    "color": "252"
  },
  "enumeration": {
    "color": "81"
  },
  "task": {
    "ticked": "✔ ",
    "unticked": "○ "
  },
  "hr": {
    "color": "240",
    "format": "─"
  }
}
